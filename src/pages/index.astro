---
// The Latent Studios homepage — the studio on paper.
//
// The studio is a lit room: the belief, one print on the wall, the four
// rooms the studio makes, and the passages that make them one house.
// The instruments keep their darkrooms on their own pages; this page is
// where you stand before you enter one. Release truth (status chips, CTA
// label, community gate) comes only from src/config/truth.ts.
//
// The previous homepage, the Develop seam over a full-bleed photograph,
// lives in git history (commit 2de45f9) and may return on the Ritual's page.
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import StatusChip from '../components/StatusChip.astro';
import { truth } from '../config/truth';

const VERSOS_URL = 'https://versos.latentstudios.art';
---

<Base
  room="paper"
  title="Latent Studios — instruments for developing photographs, and places for living with them"
  description="An independent photographic studio. The Ritual on Mac and iPad, The Moment on iPhone, The Lab in DaVinci Resolve, and Versos, a photography prize once a month."
>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/develop-3-after.webp" fetchpriority="high" />
  </Fragment>

  <Nav cta={{ label: 'Letters', href: '#letters' }} />
  <main id="main" class="studio">

    <!-- THE BELIEF, beside one print on the wall -->
    <section class="belief">
      <div class="belief-text">
        <div class="eyebrow reveal">An independent photographic studio &middot; Beirut</div>
        <h1 class="belief-line reveal reveal-heading" style="--reveal-delay: 80ms">The photograph is already there.</h1>
        <p class="belief-body reveal" style="--reveal-delay: 200ms">
          We make instruments for developing photographs, and places for
          living with them. Nothing we make competes with the picture.
          It accompanies it.
        </p>
      </div>
      <figure class="belief-print reveal reveal-media" style="--reveal-delay: 160ms">
        <div class="print">
          <img
            src="/develop-3-after.webp"
            srcset="/develop-3-after.webp 2048w, /develop-3-after-3840.webp 3840w"
            sizes="(max-width: 900px) 100vw, 42vw"
            width="2048"
            height="1365"
            alt="Children on a carousel at a fair, developed on Crystal Archive Maxima"
          />
        </div>
        <figcaption class="eyebrow">Fuji Pro 800Z, pulled one stop, on Crystal Archive Maxima &middot; developed in the Ritual</figcaption>
      </figure>
    </section>

    <!-- WHAT THE STUDIO MAKES -->
    <section class="rooms">
      <div class="rooms-head">
        <h2 class="h-italic reveal reveal-heading">What the studio makes</h2>
        <div class="eyebrow reveal" style="--reveal-delay: 80ms">Three instruments on one engine, and a prize</div>
      </div>

      <div class="rooms-grid">
        <article class="room reveal" id="ritual">
          <a class="print room-media dark" href="/ritual" aria-label="The Ritual">
            <img
              src="/ritual-darkroom-1280.webp"
              srcset="/ritual-darkroom-1280.webp 1280w, /ritual-darkroom-2560.webp 2560w"
              sizes="(max-width: 900px) 100vw, 40vw"
              width="5120"
              height="2598"
              loading="lazy"
              alt="The Darkroom in The Ritual on Mac"
            />
          </a>
          <div class="eyebrow">The Ritual &middot; Mac and iPad</div>
          <h3 class="room-title">The Ritual</h3>
          <p class="room-body">A complete photographic workroom. Gather a body of work, develop the negative, make the print, and return to it over time.</p>
          <div class="room-foot">
            <StatusChip label={truth.ritualStatus} />
            <a class="door" href="/ritual">Enter the workroom &rarr;</a>
          </div>
        </article>

        <article class="room reveal" id="moment" style="--reveal-delay: 80ms">
          <a class="print room-media light room-media-phone" href="/moment" aria-label="The Moment">
            <img
              src="/moment-journal-900.webp"
              srcset="/moment-journal-600.webp 600w, /moment-journal-900.webp 900w"
              sizes="220px"
              width="900"
              height="1956"
              loading="lazy"
              alt="A day in the journal of The Moment on iPhone"
            />
          </a>
          <div class="eyebrow">The Moment &middot; iPhone</div>
          <h3 class="room-title">The Moment</h3>
          <p class="room-body">A camera and photographer&rsquo;s journal. Photographs, places, words, and the days they belonged to.</p>
          <div class="room-foot">
            <StatusChip label={truth.momentStatus} />
            <a class="door" href="/moment">Open the journal &rarr;</a>
          </div>
        </article>

        <article class="room reveal" id="lab" style="--reveal-delay: 160ms">
          <a class="print room-media dark" href="/lab" aria-label="The Lab">
            <video data-autoplay muted loop playsinline preload="none" poster="/lab-reel-poster.webp" width="1280" height="720" aria-label="A reel of moving images developed through the Latent print engine">
              <source src="/lab-reel-1280.webm" type="video/webm" />
              <source src="/lab-reel-1280.mp4" type="video/mp4" />
            </video>
          </a>
          <div class="eyebrow">The Lab &middot; DaVinci Resolve and iPhone</div>
          <h3 class="room-title">The Lab</h3>
          <p class="room-body">The moving-image print engine. The same practice, carried into motion.</p>
          <div class="room-foot">
            <StatusChip label={truth.labStatus} />
            <a class="door" href="/lab">See the Lab &rarr;</a>
          </div>
        </article>

        <article class="room reveal" id="versos" style="--reveal-delay: 240ms">
          <a class="print room-media paper" href="/versos" aria-label="Versos">
            <img
              src="/versos-wall-1200.webp"
              srcset="/versos-wall-600.webp 600w, /versos-wall-1200.webp 1200w"
              sizes="(max-width: 900px) 100vw, 40vw"
              width="1200"
              height="630"
              loading="lazy"
              alt="The first call of Versos on paper: The light you didn't wait for."
            />
          </a>
          <div class="eyebrow">Versos &middot; a prize, once a month</div>
          <h3 class="room-title">Versos</h3>
          <p class="room-body">One line. One photograph each, any camera, a line on its verso. A named photographer chooses. Nothing is counted.</p>
          <div class="room-foot">
            <StatusChip label={truth.versosStatus} />
            <a class="door" href="/versos">See the call &rarr;</a>
          </div>
        </article>
      </div>
    </section>

    <!-- ONE ENGINE, ONE HABIT -->
    <section class="passage">
      <h2 class="h-italic reveal reveal-heading">One engine, one habit</h2>
      <div class="passage-text">
        <p class="passage-lines reveal" style="--reveal-delay: 80ms">
          The Moment catches. The Ritual lets you sit with the work. The Lab
          carries the process through motion. Versos hands one photograph to
          someone who looks.
        </p>
        <p class="passage-body reveal" style="--reveal-delay: 160ms">
          Different things, one habit. A developer that reveals instead of
          corrects. A wall where a person looks instead of a machine. Slow
          down, look again, let the photograph say what it already knows.
        </p>
      </div>
    </section>

    <!-- THE SHARED WORLD -->
    {truth.showCommunity && (
      <section class="passage">
        <h2 class="h-italic reveal reveal-heading">The shared world</h2>
        <div class="passage-text">
          <p class="passage-lines reveal" style="--reveal-delay: 80ms">Some photographs remain with us. Others are handed on.</p>
          <p class="passage-body reveal" style="--reveal-delay: 160ms">
            Keep them in a <strong>Circle</strong>, or place them in the
            <strong>Field</strong>. Once a month, hang one on the
            <a href={VERSOS_URL}><strong>wall</strong></a>. The rest belongs to
            whoever stops to look.
          </p>
        </div>
      </section>
    )}
  </main>
  <Footer />

  <style>
    .studio { max-width: 1200px; margin: 0 auto; padding: 0 72px; }

    .h-italic {
      font-family: var(--font-display);
      font-style: italic;
      font-weight: 400;
      font-size: 30px;
      line-height: 1.2;
      color: var(--text);
      margin: 0;
    }

    /* THE BELIEF */
    .belief {
      display: grid;
      grid-template-columns: 7fr 5fr;
      gap: 48px;
      align-items: end;
      padding: 150px 0 24px;
    }
    .belief-text { display: flex; flex-direction: column; gap: 26px; padding-bottom: 36px; }
    .belief-line {
      font-family: var(--font-display);
      font-style: italic;
      font-weight: 400;
      font-size: clamp(44px, 6.4vw, 78px);
      line-height: 1.02;
      letter-spacing: -0.01em;
      color: var(--text);
      margin: 0;
      text-wrap: balance;
    }
    .belief-body {
      font-size: 22px;
      line-height: 1.45;
      color: var(--text-muted);
      max-width: 30ch;
      margin: 0;
      text-wrap: pretty;
    }
    .belief-print { margin: 0; display: flex; flex-direction: column; gap: 12px; }
    .belief-print .print { aspect-ratio: 4 / 5; }
    .belief-print figcaption { text-align: right; }

    /* THE ROOMS */
    .rooms { padding: 72px 0 0; }
    .rooms-head {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      border-top: 1px solid var(--border);
      padding: 44px 0 30px;
    }
    .rooms-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 48px 36px;
    }
    .room { display: flex; flex-direction: column; gap: 14px; }
    .room-media { display: block; aspect-ratio: 16 / 10; }
    .room-media.dark { background: #1A1614; }
    .room-media.light { background: #efe7db; }
    .room-media.paper { background: #f3efe6; box-shadow: 0 1px 2px rgba(30,25,18,0.18), 0 14px 30px -14px rgba(30,25,18,0.4), inset 0 0 0 1px var(--border); display: flex; align-items: center; }
    .room-media.paper img { object-fit: contain; }
    .room-media-phone { display: flex; align-items: flex-end; justify-content: center; padding-top: 28px; }
    .room-media-phone img { width: 34%; height: auto; object-fit: contain; border-radius: 14px 14px 0 0; }
    .room-title {
      font-family: var(--font-display);
      font-weight: 400;
      font-size: 30px;
      line-height: 1.1;
      color: var(--text);
      margin: 0;
    }
    .room-body {
      font-size: 18px;
      line-height: 1.5;
      color: var(--text-muted);
      margin: 0;
      text-wrap: pretty;
    }
    .room-foot { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
    .door { font-style: italic; font-size: 17px; }

    /* PASSAGES */
    .passage {
      display: grid;
      grid-template-columns: 4fr 8fr;
      gap: 48px;
      border-top: 1px solid var(--border);
      margin-top: 72px;
      padding-top: 40px;
    }
    .passage + .passage { margin-top: 48px; }
    .passage-text { display: flex; flex-direction: column; gap: 18px; }
    .passage-lines {
      font-family: var(--font-display);
      font-style: italic;
      font-size: 26px;
      line-height: 1.4;
      color: var(--text);
      margin: 0;
      text-wrap: pretty;
    }
    .passage-body {
      font-size: 18px;
      line-height: 1.5;
      color: var(--text-muted);
      max-width: 58ch;
      margin: 0;
      text-wrap: pretty;
    }
    .passage-body strong { font-weight: 500; color: var(--text); }

    @media (max-width: 900px) {
      .studio { padding: 0 24px; }
      .belief { grid-template-columns: 1fr; gap: 32px; padding-top: 120px; }
      .belief-text { padding-bottom: 0; }
      .rooms-grid { grid-template-columns: 1fr; gap: 44px; }
      .passage { grid-template-columns: 1fr; gap: 16px; margin-top: 64px; }
      .rooms-head { flex-direction: column; gap: 8px; align-items: flex-start; }
    }
  </style>
</Base>
