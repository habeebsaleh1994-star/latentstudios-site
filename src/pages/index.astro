---
// The Latent Studios homepage — words on silk, a painted peony that opens as the page is read.
//
// Ground: /public/peony/000.webp … 095.webp (96 frames, 1620×2880, with a 540×960 small tier), scrubbed by scroll on a
// canvas, feathered into the silk with a CSS mask. Words are set directly on the silk in two
// columns that never exceed 27vw, so the plant in the middle stays clear.
//
// Truth lives in the labels below — keep them honest:
//   Nera: not yet open · The Moment: on the App Store · The Ritual: public beta · The Lab: public beta
import Base from '../layouts/Base.astro';
import '../styles/home.css';

const SUBSCRIBE_ENDPOINT = '/api/subscribe';
---

<Base
  title="Latent Studios"
  description="Born before the act. Latent Studios is an art house making instruments that help artists understand and realize themselves — Nera, The Moment, The Ritual, The Lab, and Versos."
  room="paper"
  themeColor="#dccbba"
  quiet={false}
>
  <Fragment slot="head">
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/cormorant-500-normal-latin.woff2" />
    <link rel="preload" as="image" href="/peony/small/000.webp?v=3" />
  </Fragment>
  <div id="top" class="home">
    <div class="home-ground" aria-hidden="true">
      <div class="home-weave"></div>
      <div class="home-peony" data-peony>
        <canvas data-frames="/peony/" data-frame-count="96" data-frames-version="3"></canvas>
      </div>
    </div>

    <header class="home-header">
      <a class="home-mark" href="#top">Latent Studios<span class="home-berry" aria-hidden="true"></span></a>
      <nav class="home-nav" aria-label="Rooms">
        <a href="/nera">Nera</a>
        <a href="/moment">The Moment</a>
        <a href="/ritual">The Ritual</a>
        <a href="/lab">The Lab</a>
        <a href="/versos">Versos</a>
        <a href="#letters">Letters</a>
      </nav>
    </header>

    <main id="main" class="home-main">

      <section class="home-belief">
        <h1 class="home-title" data-reveal>Born before the act.</h1>
        <p class="home-belief-line" data-reveal>A work begins before it takes form. To make is to reveal what is already there.</p>
      </section>

      <section class="row row-left">
        <p class="col home-studio" data-reveal>Latent Studios is an art house, founded by Habib Saleh. We make instruments that help artists understand and realize themselves &mdash; and the places and occasions to bring the work into the world.</p>
      </section>

      <section class="home-rooms">
        <div class="row row-right">
          <div class="col right" data-reveal>
            <div class="label">What is open</div>
            <p class="small">Each one is a place to make, or a place to put what was made.</p>
          </div>
        </div>

        <div class="row row-left">
          <a id="nera" class="col room" href="/nera" data-reveal>
            <div class="label">An instrument &middot; a listening companion &middot; not yet open</div>
            <h2 class="room-name room-name-lead">Nera</h2>
            <p class="line">&ldquo;Let me speak until I can see what I mean.&rdquo;</p>
            <p class="fact">You speak; she follows the thought as it develops, asks useful questions, and brings the conversation into a clearer account &mdash; keeping your uncertainty, your changes of mind, and your authorship.</p>
            <span class="door">Speak to Nera &rarr;</span>
          </a>
        </div>

        <div class="row row-right">
          <a id="moment" class="col room right" href="/moment" data-reveal>
            <div class="label">An instrument &middot; a camera, a pocket darkroom, a journal &middot; iPhone and iPad &middot; on the App Store</div>
            <h2 class="room-name">The Moment</h2>
            <p class="line">Notice, make, and keep a record you can return to.</p>
            <p class="fact">A camera and a photographic journal that keeps photographs and moving images alongside their places, words and days &mdash; the same development practice, carried into everyday life.</p>
            <span class="door">Open the journal &rarr;</span>
          </a>
        </div>

        <div class="row row-left">
          <a id="ritual" class="col room" href="/ritual" data-reveal>
            <div class="label">An instrument &middot; a photographic workroom &middot; Mac and iPad &middot; public beta</div>
            <h2 class="room-name">The Ritual</h2>
            <p class="line">A place to return to photographs over time, and to discover how they belong together.</p>
            <p class="fact">The life of a body of work in one room: gathering photographs, selecting and sequencing them, developing the negative, shaping the light, and making the print.</p>
            <span class="door">Enter the workroom &rarr;</span>
          </a>
        </div>

        <div class="row row-right">
          <a id="lab" class="col room right" href="/lab" data-reveal>
            <div class="label">An instrument &middot; a workroom for film &middot; Mac and DaVinci Resolve &middot; public beta</div>
            <h2 class="room-name room-name-small">The Lab</h2>
            <p class="line">Latent&rsquo;s photographic practice, carried into film.</p>
            <p class="fact">A complete passage from source footage to finished film &mdash; the same negative-to-print engine, frame after frame.</p>
            <span class="door">Enter the Lab &rarr;</span>
          </a>
        </div>

        <div class="row row-left">
          <a id="versos" class="col room" href="/versos" data-reveal>
            <div class="label">An occasion &middot; the courtyard &middot; once a month &middot; the first call is coming</div>
            <h2 class="room-name">Versos</h2>
            <p class="line">One line of poetry is the call. One work in answer, and a line on its back. A named maker chooses. Nothing is counted.</p>
            <p class="fact">Open to anyone. A named judge chooses; the chosen work hangs on a public wall for a month.</p>
            <span class="door">See the call &rarr;</span>
          </a>
        </div>

        <div class="row row-right">
          <div class="col right" data-reveal>
            <div class="label label-muted">Intended</div>
            <p class="small">Not yet made. We name them so you know where the studio is going.</p>
            <div class="pencil">
              <div>Books <span>&middot; the press</span></div>
              <div>Workshops <span>&middot; an occasion</span></div>
              <div>Cameras <span>&middot; one that gives a negative</span></div>
              <div>Production</div>
            </div>
          </div>
        </div>
      </section>

      <section class="home-belief-again">
        <h2 class="home-belief-again-line" data-reveal>A work begins before it takes form.</h2>
      </section>

      <section id="letters" class="home-letters" data-reveal>
        <div class="home-letters-desk" data-newsletter>
          <p class="line">Occasional letters from the studio. A room when it opens. A call when it comes. Nothing else.</p>
          <form class="home-letters-form" action={SUBSCRIBE_ENDPOINT} method="post" data-newsletter-form>
            <label class="visually-hidden" for="newsletter-email">Email address</label>
            <input id="newsletter-email" type="email" name="email" required autocomplete="email" placeholder="your address" />
            <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true"
                   style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0;pointer-events:none" />
            <button type="submit" class="door">Write to us</button>
          </form>
          <p class="home-letters-note" data-newsletter-error hidden role="alert">That email doesn't look right.</p>
          <p class="home-letters-note" data-newsletter-done hidden role="status" aria-live="polite">You&rsquo;re on the list. Letters will be rare.</p>
        </div>
        <div class="home-letters-colophon">
          <nav aria-label="Site">
            <a href="/nera">Nera</a>
            <a href="/moment">The Moment</a>
            <a href="/ritual">The Ritual</a>
            <a href="/lab">The Lab</a>
            <a href="/versos">Versos</a>
            <a href="mailto:contact@latentstudios.art">Contact</a>
            <a href="https://instagram.com/bylatentstudios" target="_blank" rel="noopener noreferrer">Instagram</a>
          </nav>
          <p class="home-mark home-mark-foot">Latent Studios<span class="home-berry" aria-hidden="true"></span> &nbsp;&middot;&nbsp; &copy; 2026</p>
        </div>
      </section>
    </main>
  </div>

  <script src="../scripts/home.js"></script>
</Base>
