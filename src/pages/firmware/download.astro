---
// The Ritual, in the camera: the downloads (1.1). Make Ritual Card is small, one per camera and computer; each film is
// its own file, so a fix to the app or to one film never means downloading every film again. The 1.0 downloads stay
// below, as they were. Before release the page only points back to /firmware. The firmware is free; paying is
// optional support, so nothing here reads as a price or a sale (the licence: "given to you free, not sold").
import Base from '../../layouts/Base.astro';
import { firmware, firmwareDownloads, firmwareEarlier, firmwareFilms, firmwareFilmsArriving, firmwareNeeds, firmwareVersion } from '../../config/firmware.js';
import '../../styles/home.css';
import '../../styles/ritual.css';

const released = firmware.released;
const cameras = ['Canon EOS 5D Mark II', 'Canon EOS 5D'];
const shelves = ['Colour negative', 'Black and white', 'Colour reversal (slide)', 'Motion picture'];
const size = (bytes) => (!bytes ? '' : bytes >= 1e9 ? `${(bytes / 1e9).toFixed(1)} GB` : bytes >= 1e6 ? `${Math.round(bytes / 1e6)} MB` : `${Math.round(bytes / 1e3)} KB`);
const films = (camera, shelf) => firmwareFilms.filter((film) => film.camera === camera && film.shelf === shelf);
---

<Base
  title="Download The Ritual, in the camera — Latent Studios"
  description="Download The Ritual for the Canon EOS 5D and 5D Mark II, for Mac or Windows."
  quiet={false}
  evening={false}
  announceBar={false}
>
  <div class="home ritual fw-page">
    <header class="home-header ritual-header">
      <a class="home-mark" href="/">Latent Studios<span class="home-berry" aria-hidden="true"></span></a>
      <nav class="home-nav" aria-label="Rooms">
        <a href="/nera">Nera</a>
        <a href="/moment">The Moment</a>
        <a href="/ritual">The Ritual</a>
        <a href="/lab">The Lab</a>
        <a href="https://wall.latentstudios.art">The Wall</a>
      </nav>
    </header>

    <main id="main" class="ritual-main">
      <section class="ritual-hero">
        <div class="ritual-hero-lead">
          <div class="label">The Ritual, in the camera &middot; {firmwareVersion}</div>
          <h1 class="ritual-title">Choose your camera.</h1>
          {released
            ? <p class="ritual-lede">Make Ritual Card for your computer, then the films you want, each its own file. The steps are inside, and <a href="/firmware/guide">online</a>.</p>
            : <p class="ritual-lede">Not ready yet. <a href="/firmware">Get one letter on the day it is &rarr;</a></p>}
        </div>
      </section>

      {released && (
      <section class="ritual-block tight">
        <div class="fw-cameras">
          {cameras.map((camera) => (
            <div class="fw-camera">
              <div class="label">{camera}</div>
              <p class="fact">Needs {firmwareNeeds[camera]}</p>
              <p class="fw-small">1. Make Ritual Card, for your computer:</p>
              <div class="fw-doors">
                {firmwareDownloads.filter((file) => file.camera === camera).map((file) => (
                  file.sha256
                    ? <a class="fw-door" href={`/download/firmware/${file.slug}`} download>For {file.os} <span class="fw-size">{size(file.bytes)}</span></a>
                    : <span class="fw-door" aria-disabled="true">For {file.os} &middot; in a moment</span>
                ))}
              </div>
              <p class="fw-small">2. The films you want, each a file of its own. Add them in Make Ritual Card.</p>
              {shelves.map((shelf) => films(camera, shelf).length > 0 && (
                <div class="fw-shelf">
                  <div class="fw-shelf-name">{shelf}</div>
                  <ul class="fw-films">
                    {films(camera, shelf).map((film) => (
                      firmwareFilmsArriving.has(film.slug)
                        ? <li><span aria-disabled="true">{film.title}</span> <span class="fw-size">arriving tonight</span></li>
                        : <li><a href={`/download/firmware/${film.slug}`} download>{film.title}</a> <span class="fw-size">{size(film.bytes)}</span></li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          ))}
        </div>
      </section>
      )}

      {released && (
      <section class="ritual-block tight">
        <div class="ritual-words wide fw-notes">
          <div class="label">Good to know</div>
          <p class="fact">Make Ritual Card is a small download; the films are their own files, from a few MB to 2 GB. Open &ldquo;How to use Ritual.txt&rdquo; inside before you start, or <a href="/firmware/guide">read the guide online</a>: it is kept up to date there.</p>
          <p class="fact">Already on 1.0? Delete the old download from your computer, copy your photos off your Ritual card, format that card in the camera, then make it with the new Make Ritual Card and your films. The camera&rsquo;s first-time setup is not needed again.</p>
          <p class="fact">To add a film later: download it, add it in Make Ritual Card, tick it and click &ldquo;Make the card&rdquo;. Only the new film is copied; the films already on the card and your photos stay.</p>
          <p class="fact">Shoot in RAW; RAW + JPEG works too. The Ritual develops each photograph from Canon&rsquo;s raw file. sRGB and Adobe RGB both work.</p>
          <p class="fact">Use a real CompactFlash card (8 GB or more). SD and microSD cards in a CF adapter may not work, even when the camera itself accepts them.</p>
          <p class="fact">INFO is the key button. It opens Ritual&rsquo;s film screen from anywhere in the camera, and it shows your photos as they develop. If a photo hasn&rsquo;t appeared yet, press INFO.</p>
          <p class="fact">Ritual keeps rolls, like a film camera: each film you load starts a roll, 36 frames, each roll its own folder on the card with its index print.</p>
          <p class="fact">On a Mac, Make Ritual Card needs macOS 12 (Monterey) or later. On an older Mac, use a Windows PC.</p>
          <p class="fact">On Windows, the first time you open it Windows says &ldquo;Windows protected your PC&rdquo;. Choose More info, then Run anyway.</p>
          <p class="fact">If it earns a place in your camera, you can <a href="/firmware">pay what you want</a> any time. It helps bring The Ritual to more cameras.</p>
          <p class="fw-small">Not affiliated with or endorsed by Canon Inc. Canon and EOS are trademarks of Canon Inc. Custom firmware is installed at your own risk; follow the steps that come with it.</p>
        </div>
      </section>
      )}
      {released && (
      <section class="ritual-block tight">
        <div class="ritual-words wide fw-notes">
          <div class="label">The Ritual 1.0</div>
          <p class="fw-small">The first release, as it was: each download with the camera&rsquo;s 20 films inside. 1.1 is the one to use.</p>
          <ul class="fw-films">
            {firmwareEarlier.map((file) => (
              <li><a href={`/download/firmware/${file.slug}`} download>{file.camera}, for {file.os}</a> <span class="fw-size">{size(file.bytes)}</span></li>
            ))}
          </ul>
        </div>
      </section>
      )}
    </main>
  </div>

  <style>
    .fw-cameras { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px; }
    @media (max-width: 720px) { .fw-cameras { grid-template-columns: 1fr; gap: 56px; } }
    .fw-notes { display: grid; gap: 14px; }
    .fw-notes .fw-small { margin-top: 10px; }
    .fw-camera { display: grid; gap: 12px; align-content: start; }
    .fw-doors { display: flex; flex-wrap: wrap; gap: 10px; }
    .fw-door { font-size: 18px; color: var(--ground, #1A1614); background: var(--amber-accent); border-radius: 999px; padding: 14px 28px; text-decoration: none; }
    .fw-door[aria-disabled="true"] { opacity: .4; }
    .fw-size { opacity: .7; margin-left: 8px; font-size: 15px; }
    .fw-shelf { display: grid; gap: 6px; }
    .fw-shelf-name { font-size: 13px; letter-spacing: .08em; text-transform: uppercase; color: var(--soft); }
    .fw-films { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
    .fw-films a { color: inherit; text-decoration: underline; text-underline-offset: 3px; text-decoration-color: color-mix(in srgb, currentColor 35%, transparent); }
    .fw-films .fw-size { font-size: 14px; }
    .fw-small { font-size: 15px; line-height: 1.6; color: var(--soft); max-width: 70ch; margin: 0; }
  </style>
</Base>
