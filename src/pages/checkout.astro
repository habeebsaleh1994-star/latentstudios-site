---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="Purchase Print Engine — Latent Studios"
  description="Purchase Latent Print Engine securely through Latent Manager."
>
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
  </Fragment>
  <Nav />
  <main class="legal" id="main">
    <div class="legal-label">Latent Print Engine</div>
    <h1>Purchase in Latent Manager.</h1>
    <p class="legal-lead">
      Your account, purchase, installation, and license stay together in one place.
    </p>
    <p>
      <a href="/download/print-engine">Download Latent Print Engine for macOS</a>, install it,
      then open Latent Manager from Applications. Sign in with Google and choose the
      $199 annual plan with its card-required seven-day trial, or the $499 perpetual license.
      Manager opens Paddle&rsquo;s secure checkout and activates your Mac when payment is complete.
      There is no license key to copy or wait for.
    </p>
    <p>
      One Latent account can restore Print Engine on up to two Macs. For help, write to
      <a href="mailto:support@latentstudios.art">support@latentstudios.art</a>.
    </p>
    <p>
      <a href="/terms">Terms</a>
      &ensp;&middot;&ensp;
      <a href="/privacy">Privacy</a>
      &ensp;&middot;&ensp;
      <a href="/refund">Refunds</a>
    </p>
    <a class="legal-back" href="/lab">← Explore Print Engine</a>
  </main>
  <Footer />

  <style>
    .legal { max-width: 720px; margin: 0 auto; padding: 140px 24px 120px; }
    .legal-label { font-family: var(--font-label); font-weight: 300; font-size: 10px; letter-spacing: 0.28em; text-transform: uppercase; color: var(--amber-dim); margin-bottom: 20px; }
    .legal h1 { font-family: var(--font-display); font-weight: 300; font-size: 40px; letter-spacing: -0.01em; color: var(--text-bright); margin-bottom: 12px; }
    .legal-lead { font-size: 18px !important; line-height: 1.75 !important; color: var(--text) !important; }
    .legal p { font-family: var(--font-body); font-weight: 300; font-size: 16px; line-height: 1.7; color: var(--text-muted); margin-bottom: 14px; }
    .legal a { color: var(--amber); text-decoration: none; border-bottom: 1px solid var(--border-light); transition: color 0.3s ease, text-shadow 0.6s ease, border-color 0.6s ease; }
    .legal a:hover { color: var(--text-bright); text-shadow: 0 0 16px rgba(232, 196, 160, 0.5); border-color: transparent; }
    .legal-back { display: inline-block; margin-top: 48px; font-family: var(--font-label); font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--amber-dim); border-bottom: none; }
    .legal-back:hover { color: var(--text-bright); text-shadow: 0 0 16px rgba(232, 196, 160, 0.5); }
  </style>
</Base>
