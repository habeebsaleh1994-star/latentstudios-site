---
// The Moment — a camera, a pocket darkroom, a journal. iPhone and iPad. On the App Store.
//
// The App Store story, made a page of the house: the nine screens and their sentences,
// on the app's own two grounds (the Journal's parchment by day, the Evening after dark),
// inside the homepage's shell. No status chip, no pricing in the nav, no lamp switch.
//
// Truth: on the App Store · free to download · a membership opens the shelf.
import Base from '../layouts/Base.astro';
import '../styles/home.css';
import '../styles/moment.css';

// "Latent The Moment" (com.latent.moment) — country-agnostic link; the store picks the visitor's storefront.
const APP_STORE_URL = 'https://apps.apple.com/app/latent-the-moment/id6786220649';
const SUBSCRIBE_ENDPOINT = '/api/subscribe';

// Eight screens from The Moment 1.5.1's App Store set, cut just below each headline (the page sets the words).
const SCREEN_W = 1032;
const SCREEN_H = 1709;
const scenes = [
  { kick: 'The Moment', head: 'Every photograph you take, developed through a film and a paper', src: '/moment/151-01.webp', alt: 'The camera with a film loaded, the shelf of films open beneath the photograph' },
  { kick: 'Your days', head: 'Every day becomes a roll', src: '/moment/151-02.webp', alt: 'A roll for 23 October: a line about the evening, and every frame of the day' },
  { kick: 'Films', head: 'Every film with a character of its own', src: '/moment/151-03.webp', alt: 'Two films side by side, Vision3 200T and Kodachrome 200' },
  { kick: 'Prints', head: 'Prints that age the way paper does', src: '/moment/151-04.webp', alt: 'Two prints on a dark table, one in colour and one in black and white' },
  { kick: 'The Field', head: 'Photographs from the people you love', src: '/moment/151-05.webp', alt: 'This week on the Field: prints from the people you follow' },
  { kick: 'The Wall', head: 'One question a week, one photograph', src: '/moment/151-06.webp', alt: 'The Wall: this week, The last warm day by the sea' },
  { kick: 'Homes', head: 'A home for your photographs', src: '/moment/151-07.webp', alt: 'A home: prints, films and places' },
  { kick: 'The Window', head: 'Look into the windows of the homes you follow', src: '/moment/151-08.webp', alt: 'The Window: a photograph from a home you follow, and a letter to its maker' },
];

// The iPad set from the same listing, cropped to the tablet's edge (1600 wide); the page rounds the corners.
const IPAD_W = 1600;
const IPAD_H = 1194;
const ipads = {
  shelf:    { src: '/moment/ipad-shelf.webp',    alt: 'The Moments shelf on iPad: rolls, a Cartridge and a Tape, four across' },
  darkroom: { src: '/moment/ipad-darkroom.webp', alt: 'The darkroom on iPad: the print under the lamp, the develop deck open beside it' },
  field:    { src: '/moment/ipad-field.webp',    alt: 'The Field on iPad: two prints wide, latest first' },
};
---

<Base
  title="The Moment — Latent Studios"
  description="A camera and a photographer's journal for iPhone and iPad. Take photographs, keep them in rolls, and let them become something worth returning to. Free to download."
  ogImage="/og-moment.png?v=3"
  ogImageAlt="The Moment — a camera and photographer's journal, on iPhone and iPad"
  room="paper"
  themeColor="#f3eee6"
  quiet={false}
>
  <Fragment slot="head">
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/cormorant-500-normal-latin.woff2" />
    <link rel="preload" as="image" href={scenes[0].src} />
  </Fragment>
  <div class="home moment">

    <header class="home-header moment-header">
      <a class="home-mark" href="/">Latent Studios<span class="home-berry" aria-hidden="true"></span></a>
      <nav class="home-nav" aria-label="Rooms">
        <a href="/moment" aria-current="page">The Moment</a>
        <a href="/ritual">The Ritual</a>
        <a href="/lab">The Lab</a>
        <a href="https://wall.latentstudios.art">The Wall</a>
        <a href="#letters">Letters</a>
      </nav>
    </header>

    <main id="main" class="moment-main">

      <section class="moment-hero day">
        <div class="moment-wrap moment-hero-row">
          <div class="moment-hero-lead" data-reveal>
            <div class="label">An instrument &middot; a camera, a pocket darkroom, a journal &middot; iPhone and iPad</div>
            <h1 class="moment-title">The Moment</h1>
            <p class="moment-lede">Take photographs, keep them in rolls, and let them become something worth returning to.</p>
          </div>
          <div class="moment-hero-aside" data-reveal>
            <p class="fact">A camera and a photographer&rsquo;s journal. Capture, film development, motion, notes and sharing in one quiet place. Free to download; a membership opens the whole shelf.</p>
            <a class="moment-door" href={APP_STORE_URL}>Open the journal<span class="home-berry moment-door-berry" aria-hidden="true"></span></a>
            <div class="label">On the App Store</div>
            <a class="moment-badge" href={APP_STORE_URL}><img src="/moment/app-store-badge.svg" alt="Download on the App Store" width="120" height="40" /></a>
          </div>
        </div>
      </section>

      {scenes.map((scene, i) => (
        <section class:list={['moment-scene', 'night', { first: i === 0 }]}>
          <div class:list={['moment-wrap', 'moment-row', { reverse: i % 2 === 1 }]}>
            {i % 2 === 1 && <figure class="moment-screen" data-reveal><img src={scene.src} alt={scene.alt} width={SCREEN_W} height={SCREEN_H} loading="lazy" /></figure>}
            <div class="moment-words" data-reveal>
              <div class="label">{scene.kick}</div>
              <h2>{scene.head}</h2>
            </div>
            {i % 2 === 0 && <figure class="moment-screen" data-reveal><img src={scene.src} alt={scene.alt} width={SCREEN_W} height={SCREEN_H} loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} /></figure>}
          </div>
        </section>
      ))}

      <section class="moment-scene moment-ipad night last">
        <div class="moment-wrap">
          <div class="moment-words" data-reveal>
            <h2>And on iPad, a wider bench.</h2>
            <p>The shelf four across, the darkroom open flat, the Field two prints wide. The same journal; nothing hidden behind a swipe.</p>
          </div>
          <div class="moment-ipad-row">
            <figure class="moment-ipad-screen" data-reveal><img src={ipads.shelf.src} alt={ipads.shelf.alt} width={IPAD_W} height={IPAD_H} loading="lazy" /></figure>
            <figure class="moment-ipad-screen" data-reveal><img src={ipads.darkroom.src} alt={ipads.darkroom.alt} width={IPAD_W} height={IPAD_H} loading="lazy" /></figure>
            <figure class="moment-ipad-screen" data-reveal><img src={ipads.field.src} alt={ipads.field.alt} width={IPAD_W} height={IPAD_H} loading="lazy" /></figure>
          </div>
        </div>
      </section>

      <section class="moment-terms day first">
        <div class="moment-wrap moment-terms-row" data-reveal>
          <div class="moment-term">
            <div class="label">Free, and without an account</div>
            <p class="line">The camera, your library, import, the starter film and paper shelf, photo and video development, and export.</p>
          </div>
          <div class="moment-term">
            <div class="label">With a membership</div>
            <p class="line">The complete shelf, print Finish, Extended Light, Cinema Negative, Cartridge and Tape, Projector effects and gates, Circle-making, Envelopes, and library transfer.</p>
            <p class="fact">What you have made stays viewable and exportable, member or not. No ads, no analytics, no tracking. Your library stays on your device; only what you publish or place in a Circle leaves it.</p>
          </div>
        </div>
      </section>

      <section id="letters" class="moment-letters day" data-reveal>
        <div class="moment-wrap moment-letters-row">
          <div class="home-letters-desk" data-newsletter>
            <a class="moment-door" href={APP_STORE_URL}>Open the journal<span class="home-berry moment-door-berry" aria-hidden="true"></span></a>
            <p class="fact">On the App Store for iPhone and iPad. Occasional letters from the studio, if you leave an address.</p>
            <a class="moment-badge" href={APP_STORE_URL}><img src="/moment/app-store-badge.svg" alt="Download on the App Store" width="120" height="40" /></a>
            <form class="home-letters-form" action={SUBSCRIBE_ENDPOINT} method="post" data-newsletter-form>
              <label class="visually-hidden" for="newsletter-email">Email address</label>
              <input id="newsletter-email" type="email" name="email" required autocomplete="email" placeholder="your address" />
              <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true"
                     style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0;pointer-events:none" />
              <button type="submit" class="door">Write to me</button>
            </form>
            <p class="home-letters-note" data-newsletter-error hidden role="alert">That email doesn't look right.</p>
            <p class="home-letters-note" data-newsletter-done hidden role="status" aria-live="polite">You&rsquo;re on the list. Letters will be rare.</p>
          </div>
          <div class="home-letters-colophon">
            <nav aria-label="Site">
              <a href="/ritual">The Ritual</a>
              <a href="/lab">The Lab</a>
              <a href="https://wall.latentstudios.art">The Wall</a>
              <a href="/privacy">Privacy</a>
              <a href="/terms">Terms</a>
              <a href="mailto:moment@latentstudios.art">Contact</a>
            </nav>
            <p class="home-mark home-mark-foot">Latent Studios<span class="home-berry" aria-hidden="true"></span> &nbsp;&middot;&nbsp; &copy; 2026</p>
          </div>
        </div>
      </section>
    </main>
  </div>

  <style is:global>
    /* global.css paints every paper-page link amber at body.room-paper a (0,1,1), which outranks
       moment.css's .moment-door (0,1,0). The door is a word in ink; only its berry is copper. */
    body.room-paper .moment .moment-door { color: var(--ink); }
    body.room-paper .moment .moment-door:hover { color: var(--copper-deep); }
    /* Apple's own badge (their marketing SVG, untouched), at its 40px minimum, with its clear space. */
    .moment-badge { display: inline-block; line-height: 0; margin-top: 4px; }
    .moment-badge img { display: block; height: 40px; width: auto; }
    /* iPad: the words above, three tablets in a row beneath; the artwork carries its own corners and shadow. */
    .moment-ipad-row { display: flex; flex-wrap: wrap; gap: clamp(20px, 3vw, 40px); margin-top: clamp(40px, 6vh, 72px); }
    .moment-ipad-screen { flex: 1 1 300px; min-width: 0; margin: 0; border-radius: clamp(10px, 1.6vw, 22px); overflow: hidden; }
    .moment-ipad-screen img { display: block; width: 100%; height: auto; }
  </style>

  <!-- newsletter.js is already loaded by Base.astro; only the reveal is this page's own. -->
  <script src="../scripts/reveal.js"></script>
</Base>
