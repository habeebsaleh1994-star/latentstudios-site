---
import Base from '../../layouts/Base.astro';
---

<Base
  title="Latent Print Engine — Private Beta"
  description="A private testing release of Latent Print Engine for DaVinci Resolve on Mac."
  ogImageAlt="Latent Print Engine — private beta"
>
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />
  </Fragment>

  <main class="release" id="main">
    <div class="release-glow" aria-hidden="true"></div>

    <section class="release-card" aria-labelledby="release-title">
      <img
        class="mark"
        src="/latent-print-engine-icon.png"
        width="1024"
        height="1024"
        alt=""
        aria-hidden="true"
      />

      <p class="eyebrow">Private beta · macOS</p>
      <h1 id="release-title">Latent Print Engine</h1>
      <p class="version">Version 0.1.170</p>
      <p class="lead">
        One negative-to-print engine inside DaVinci Resolve. This invitation
        includes the engine, License Manager, and full film-gate plate library.
      </p>

      <div class="release-state" data-release-state aria-live="polite">
        <span class="state-dot" aria-hidden="true"></span>
        <span data-state-copy>Checking your invitation…</span>
      </div>

      <a class="download" data-download aria-disabled="true">
        <span>Download for Mac</span>
        <small>Installer · 963 MB</small>
      </a>

      <div class="instructions">
        <p><span>1</span> Download and open the installer.</p>
        <p><span>2</span> Restart DaVinci Resolve after installation.</p>
        <p><span>3</span> Add Latent Print Engine, then enter your personal beta code under License.</p>
      </div>

      <p class="note">
        Your download link and personal beta code are private. Please do not
        forward them.
      </p>
    </section>
  </main>

  <script>
    const state = document.querySelector('[data-release-state]');
    const copy = document.querySelector('[data-state-copy]');
    const download = document.querySelector('[data-download]');
    const access = new URLSearchParams(window.location.search).get('access');

    const setState = (kind, message) => {
      state?.setAttribute('data-kind', kind);
      if (copy) copy.textContent = message;
    };

    if (!access) {
      setState('closed', 'A private invitation is required.');
    } else {
      const endpoint = `/api/print-engine/download?access=${encodeURIComponent(access)}`;
      fetch(endpoint, { method: 'HEAD', cache: 'no-store' })
        .then((response) => {
          if (!response.ok) throw new Error('Invitation unavailable');
          if (download instanceof HTMLAnchorElement) {
            download.href = endpoint;
            download.removeAttribute('aria-disabled');
          }
          setState('ready', 'Your invitation is ready.');
        })
        .catch(() => setState('closed', 'This invitation is unavailable or has expired.'));
    }
  </script>

  <style>
    .release {
      position: relative;
      min-height: 100svh;
      display: grid;
      place-items: center;
      overflow: hidden;
      padding: 64px 24px;
      background:
        linear-gradient(180deg, rgba(255,255,255,.012), transparent 34%),
        var(--bg-deep);
    }
    .release-glow {
      position: absolute;
      width: min(880px, 130vw);
      aspect-ratio: 1;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(232,196,160,.085), transparent 64%);
      pointer-events: none;
    }
    .release-card {
      position: relative;
      width: min(100%, 720px);
      margin: 0;
      padding: 66px 70px 54px;
      text-align: center;
      border: 1px solid var(--border-light);
      border-radius: 20px;
      background: var(--bg);
      box-shadow: 0 34px 110px rgba(0,0,0,.42);
    }
    .mark {
      width: 112px;
      height: 112px;
      margin: -12px auto 22px;
      object-fit: contain;
    }
    .eyebrow {
      font-family: var(--font-label);
      font-size: 11px;
      font-weight: 400;
      letter-spacing: .24em;
      text-transform: uppercase;
      color: var(--amber);
    }
    h1 {
      margin: 20px 0 0;
      font-family: var(--font-display);
      font-size: clamp(38px, 6vw, 56px);
      font-weight: 300;
      line-height: 1.05;
      letter-spacing: .025em;
      color: var(--text-bright);
    }
    .version {
      margin-top: 14px;
      font-family: var(--font-label);
      font-size: 11px;
      font-weight: 400;
      letter-spacing: .14em;
      color: var(--text-muted);
      text-transform: uppercase;
    }
    .lead {
      max-width: 520px;
      margin: 30px auto 0;
      font-size: 18px;
      font-weight: 400;
      line-height: 1.65;
      color: var(--text);
    }
    .release-state {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 10px;
      margin: 34px 0 20px;
      font-family: var(--font-label);
      font-size: 11px;
      font-weight: 400;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: var(--text);
    }
    .state-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--amber-dim);
      box-shadow: 0 0 12px rgba(232,196,160,.3);
    }
    .release-state[data-kind='ready'] { color: var(--amber); }
    .release-state[data-kind='ready'] .state-dot { background: #9fbd89; box-shadow: 0 0 12px rgba(159,189,137,.45); }
    .release-state[data-kind='closed'] .state-dot { background: var(--text-ghost); box-shadow: none; }
    .download {
      display: flex;
      min-height: 74px;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 3px;
      border-radius: 10px;
      background: var(--amber);
      color: var(--bg-deep);
      font-family: var(--font-label);
      font-size: 13px;
      font-weight: 400;
      letter-spacing: .15em;
      text-transform: uppercase;
      text-decoration: none;
      transition: background .2s ease, transform .12s ease, opacity .2s ease;
    }
    .download:hover { background: var(--text-bright); }
    .download:active { transform: scale(.995); }
    .download[aria-disabled='true'] { pointer-events: none; opacity: .28; }
    .download small {
      font-family: var(--font-body);
      font-size: 13px;
      font-weight: 400;
      letter-spacing: .01em;
      text-transform: none;
      opacity: .76;
    }
    .instructions {
      display: grid;
      gap: 14px;
      margin: 42px 0 0;
      padding-top: 34px;
      border-top: 1px solid var(--border);
      text-align: left;
    }
    .instructions p {
      display: grid;
      grid-template-columns: 26px 1fr;
      gap: 12px;
      align-items: baseline;
      color: var(--text);
      font-size: 15px;
      font-weight: 400;
      line-height: 1.55;
    }
    .instructions span {
      font-family: var(--font-label);
      font-size: 10px;
      font-weight: 400;
      color: var(--amber);
    }
    .note {
      margin: 32px auto 0;
      max-width: 480px;
      font-size: 13px;
      font-weight: 400;
      line-height: 1.65;
      color: var(--text-muted);
    }
    @media (max-width: 620px) {
      .release { padding: 20px 14px; }
      .release-card { padding: 48px 24px 36px; border-radius: 15px; }
      .mark { width: 96px; height: 96px; margin-top: -10px; }
      .lead { font-size: 17px; }
    }
    @media (prefers-reduced-motion: reduce) {
      .download { transition: none; }
    }
  </style>
</Base>
