  {/* newsletter.js is already loaded by Base.astro; only the reveal is this page's own. */}
  <script src="../scripts/reveal.js"></script>
  <script src="../scripts/source.js"></script>

<script>
  // Where The Ritual cannot run (DeviceProbe), a plan's Choose button carries the plan into the send-to-Mac form.
  document.querySelectorAll<HTMLAnchorElement>('[data-choose-plan]').forEach((choose) => choose.addEventListener('click', (event) => {
    if (!document.documentElement.hasAttribute('data-away')) return;
    const form = document.getElementById('send-mac-plans');
    if (!form) return;
    event.preventDefault();
    form.dispatchEvent(new CustomEvent('send-mac:plan', { detail: choose.dataset.choosePlan }));
    form.scrollIntoView({ behavior: 'smooth', block: 'center' });
    form.querySelector<HTMLInputElement>('input[type="email"]')?.focus({ preventScroll: true });
  }));
  // The film shelf: a press develops the same raw on another film (every development is a real engine render).
  document.querySelectorAll('.ritual-filmshow').forEach((show) => {
    const pick = (id) => {
      show.querySelectorAll('.ritual-filmshow-img').forEach((img) => img.classList.toggle('on', img.dataset.film === id));
      show.querySelectorAll('.ritual-filmshow-film').forEach((b) => {
        const on = b.dataset.film === id;
        b.classList.toggle('on', on);
        b.setAttribute('aria-checked', on ? 'true' : 'false');
      });
    };
    show.querySelectorAll('.ritual-filmshow-film').forEach((b) => b.addEventListener('click', () => pick(b.dataset.film)));
  });
  // Before and after: a hairline that glides — once from the edge when the viewer arrives, then after the pointer,
  // eased, never jumping. Touch drags; arrow keys step. A tab cross-fades to its pair and the reveal plays again.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll('.ritual-compare').forEach((box) => {
    let cut = 100, target = 100, raf = 0, revealed = false;
    const apply = () => {
      box.style.setProperty('--cut', `${cut}%`);
      box.style.setProperty('--before-tag', String(Math.min(1, Math.max(0, (cut - 8) / 14))));
      box.style.setProperty('--after-tag', String(Math.min(1, Math.max(0, (92 - cut) / 14))));
      const plate = box.querySelector('.ritual-compare-plate.on');
      if (plate) plate.setAttribute('aria-valuenow', String(Math.round(cut)));
    };
    const step = () => {
      cut += (target - cut) * 0.16;
      if (Math.abs(target - cut) < 0.05) cut = target;
      apply();
      raf = cut === target ? 0 : requestAnimationFrame(step);
    };
    const glide = (v) => { target = Math.max(0, Math.min(100, v)); if (reduce) { cut = target; apply(); return; } if (!raf) raf = requestAnimationFrame(step); };
    const reveal = () => {
      if (reduce) { cut = target = 50; apply(); return; }
      cut = 100; target = 100; apply();
      const start = performance.now(), from = 100, to = 50, dur = 1400;
      const tick = (t) => {
        const k = Math.min(1, (t - start) / dur), e = k < 0.5 ? 4 * k * k * k : 1 - Math.pow(-2 * k + 2, 3) / 2;
        cut = target = from + (to - from) * e; apply();
        if (k < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };
    apply();
    new IntersectionObserver((entries, obs) => {
      if (entries.some((e) => e.isIntersecting) && !revealed) { revealed = true; reveal(); obs.disconnect(); }
    }, { threshold: 0.45 }).observe(box);
    box.querySelectorAll('.ritual-compare-plate').forEach((plate) => {
      const at = (e) => { const r = plate.getBoundingClientRect(); return ((e.clientX - r.left) / r.width) * 100; };
      let dragging = false;
      plate.addEventListener('pointermove', (e) => { if (e.pointerType === 'mouse' || dragging) glide(at(e)); });
      plate.addEventListener('pointerdown', (e) => { dragging = true; plate.setPointerCapture(e.pointerId); glide(at(e)); });
      plate.addEventListener('pointerup', () => { dragging = false; });
      plate.addEventListener('pointercancel', () => { dragging = false; });
      plate.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft' || e.key === 'ArrowRight') { e.preventDefault(); glide(target + (e.key === 'ArrowLeft' ? -5 : 5)); }
      });
    });
    box.querySelectorAll('.ritual-compare-choose button').forEach((b) => b.addEventListener('click', () => {
      box.querySelectorAll('.ritual-compare-plate, .ritual-compare-note').forEach((p) => {
        const on = p.dataset.pair === b.dataset.pair;
        p.classList.toggle('on', on);
        if (p.classList.contains('ritual-compare-plate')) p.tabIndex = on ? 0 : -1;
      });
      box.querySelectorAll('.ritual-compare-choose button').forEach((x) => {
        const on = x === b; x.classList.toggle('on', on); x.setAttribute('aria-checked', on ? 'true' : 'false');
      });
      reveal();
    }));
  });
</script>
</Base>
