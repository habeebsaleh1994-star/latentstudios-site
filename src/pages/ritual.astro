---
// The Ritual — a complete photographic workroom, on Mac and iPad.
//
// Still a darkroom: the repo's own dark tokens, unchanged. What changed is the shell —
// the house's header and letters desk, Cormorant + Instrument Sans, the left/right
// asymmetry the homepage uses, and doors as words. No safelight pulse, no status chip,
// no amber CTA button, no lamp switch.
//
// The room captures are the app as it ships (13 October 2026, The Ritual 1.0.3 on a library of
// 382 photographs from Lebanon). The Mac/iPad pair and the Story films are still the July 2026
// captures, until the iPad edition can be captured beside the Mac.
import Base from '../layouts/Base.astro';
import '../styles/home.css';
import '../styles/ritual.css';
import { truth } from '../config/truth';
import { ritualCommerce } from '../config/ritual-commerce.js';

const SUBSCRIBE_ENDPOINT = '/api/subscribe';

const rooms = [
  { n: '01', name: 'Studio', slug: 'studio',
    line: 'The front door. It remembers your work before asking for a task.',
    alt: 'The Studio in The Ritual on Mac — the newest print, a boy holding a worn football, across the top, and the prints on the wall beneath it' },
  { n: '02', name: 'Workbench', slug: 'workbench',
    line: 'Today’s work, gathered — and the archive’s physical truth kept visible.',
    alt: 'The Workbench in The Ritual on Mac — the photograph last left in the Darkroom, a print drying on the line, and rows of frames waiting to be developed and chosen' },
  { n: '03', name: 'Light Table', slug: 'lighttable',
    line: 'Read, compare, narrow, and arrange a body of work.',
    alt: 'The Light Table in The Ritual on Mac — a rated grid of a body of work from Lebanon beside one photograph held large with its details' },
  { n: '04', name: 'Darkroom', slug: 'darkroom',
    line: 'The deep working room, from negative to print.',
    alt: 'The Darkroom in The Ritual on Mac — a portrait developing on Portra 400, the Film, Paper, Finish and Retouch steps at left and the film shelf at right' },
];

// Nine of the 83 on the shelf (colour/catalog/films.json, 2026-10-12): one from each process the app
// develops, the names people know. Each swatch is the stock's own dot from the app's catalogue (dot_color),
// not a colour chosen for the page. The full catalogue lives in the app.
const stocks = [
  { name: 'Portra 400', family: 'Kodak · C-41', swatch: '#E2BFA8' },
  { name: 'Ektar 100', family: 'Kodak · C-41', swatch: '#E2BFA8' },
  { name: 'Pro 400H', family: 'Fujifilm · C-41', swatch: '#E2BFA8' },
  { name: 'Velvia 50', family: 'Fujifilm · E-6', swatch: '#C8A13A' },
  { name: 'Provia 100F', family: 'Fujifilm · E-6', swatch: '#2E9E7A' },
  { name: 'Kodachrome 64', family: 'Kodak · K-14', swatch: '#E3B23C' },
  { name: 'Vision3 500T', family: 'Kodak · ECN-2', swatch: '#A67B5B' },
  { name: 'HP5 Plus', family: 'Ilford · B&W', swatch: '#A0A0A0' },
  { name: 'Tri-X 400', family: 'Kodak · B&W', swatch: '#B4B4B4' },
];
---

<Base
  title="The Ritual — a complete photographic workroom"
  description="Live with a body of work from the first import to the finished print — develop the negative, mend the light, make the print. The Ritual, for Mac; iPad follows, included with every plan."
  ogImage="/og-ritual.png?v=1"
  ogImageAlt="The Ritual — a complete photographic workroom for Mac, with iPad to follow"
  quiet={false}
  evening={false}
>
  <Fragment slot="head">
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/cormorant-500-normal-latin.woff2" />
    {/* The hero capture is this page's LCP image. */}
    <link rel="preload" as="image" href="/ritual-darkroom-2560.webp"
      imagesrcset="/ritual-darkroom-1280.webp 1280w, /ritual-darkroom-2560.webp 2560w"
      imagesizes="(max-width: 1288px) 100vw, 1240px" fetchpriority="high" />
  </Fragment>

  <div class="home ritual">

    <header class="home-header ritual-header">
      <a class="home-mark" href="/">Latent Studios<span class="home-berry" aria-hidden="true"></span></a>
      <nav class="home-nav" aria-label="Rooms">
        <a href="/nera">Nera</a>
        <a href="/moment">The Moment</a>
        <a href="/ritual" aria-current="page">The Ritual</a>
        <a href="/lab">The Lab</a>
        <a href="/versos">Versos</a>
        <a href="#letters">Letters</a>
      </nav>
    </header>

    <main id="main" class="ritual-main">

      <section class="ritual-hero">
        <div class="ritual-hero-row">
          <div class="ritual-hero-lead" data-reveal>
            <div class="label">An instrument &middot; a photographic workroom &middot; {truth.ritualPlatformStatus}</div>
            <h1 class="ritual-title">A complete photographic workroom.</h1>
            <p class="ritual-lede">Live with a body of work from the first import to the finished print.</p>
          </div>
          <div class="ritual-hero-aside" data-reveal>
            <p class="fact">Remember it, gather it, decide what matters, develop the negative, mend the light, make the print, and send it out.</p>
            <a class="ritual-door" href={ritualCommerce.releaseOpen ? '#access' : '#letters'}>Enter the workroom<span class="home-berry ritual-door-berry" aria-hidden="true"></span></a>
            <div class="label">{truth.ritualStatus}</div>
          </div>
        </div>
        <figure class="ritual-plate wide" data-reveal>
          <img src="/ritual-darkroom-2560.webp"
               srcset="/ritual-darkroom-1280.webp 1280w, /ritual-darkroom-2560.webp 2560w"
               sizes="(max-width: 1288px) 100vw, 1240px"
               width="5120" height="2668" fetchpriority="high"
               alt="The Darkroom in The Ritual on Mac — a boy holding a worn football, developed on Portra 400 and printed on Endura Premier, the negative's curve at left and the colour negative films at right" />
        </figure>
      </section>

      <section class="ritual-block">
        <div class="ritual-words" data-reveal>
          <div class="label">The rooms</div>
          <h2>One place to live with the work.</h2>
          <p class="fact">Studio remembers. Workbench gathers what needs you today. Light Table helps you decide. Darkroom carries the photograph from negative to print.</p>
        </div>
        <div class="ritual-rooms">
          {rooms.map((room) => (
            <div class="ritual-room" data-reveal>
              <figure class="ritual-plate">
                <img src={`/ritual-${room.slug}-1280.webp`}
                     srcset={`/ritual-${room.slug}-640.webp 640w, /ritual-${room.slug}-1280.webp 1280w`}
                     sizes="(max-width: 900px) 90vw, 330px"
                     width="5120" height="2668" loading="lazy" alt={room.alt} />
              </figure>
              <div class="ritual-room-foot">
                <div class="label small">{room.n} &middot; {room.name}</div>
                <p class="line">{room.line}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section class="ritual-aside-right">
        <div class="ritual-words right" data-reveal>
          <div class="label">The process</div>
          <h2 class="large">Film, paper, finish.</h2>
          <p class="fact">Expose and develop the negative in Film &mdash; push it, pull it, hold the shutter open long enough for the film to fail the way it really fails. Print it on Paper, under the light where it will be seen. Finish it for the screen. Nothing is a look pasted on at the end; each choice belongs to the same developing photograph.</p>
        </div>
      </section>

      <section class="ritual-block">
        <div class="ritual-words" data-reveal>
          <div class="label">The materials</div>
          <h2>Film as behaviour, not as a look.</h2>
          <p class="fact">Every stock begins from its maker&rsquo;s own data &mdash; its curves, its dyes, its grain, its sharpness, its reciprocity &mdash; and is developed in its own chemistry: colour negative, slide, Kodachrome, motion-picture negative, black and white. Then it is printed on a real paper, or scanned the way a lab would scan it.</p>
        </div>
        <div class="ritual-stocks" data-reveal>
          {stocks.map((stock) => (
            <div class="ritual-stock">
              <span class="ritual-swatch" style={`background: ${stock.swatch}`} aria-hidden="true"></span>
              <span class="ritual-stock-name">{stock.name}</span>
              <span class="ritual-stock-family">{stock.family}</span>
            </div>
          ))}
          <p class="ritual-stocks-coda">Nine of 83 on the shelf today, with 21 papers to print them on. The catalogue keeps growing, and every stock behaves like the material it remembers.</p>
        </div>
      </section>

      <section class="ritual-aside-right">
        <div class="ritual-words right" data-reveal>
          <div class="label">The finishing bench</div>
          <h2>Retouch the negative, not the surface.</h2>
          <p class="fact">Repair what distracts. Shape local light and tone. Work gently with a face. Every touch inherits the photograph&rsquo;s grain, density and roll-off &mdash; and redevelops when the process changes.</p>
          <div class="label">Repair &nbsp;&middot;&nbsp; Light &amp; Tone &nbsp;&middot;&nbsp; Portrait</div>
        </div>
      </section>

      <section class="ritual-block">
        <div class="ritual-words" data-reveal>
          <div class="label">The Print Room</div>
          <h2>Make the print.</h2>
          <p class="fact">Strike a test strip. Balance the filters or split the grade. Preflash, dodge, burn, keep a work print, and make the final print under the light where it will be seen.</p>
        </div>
        <figure class="ritual-plate push-right" data-reveal>
          <img src="/ritual-printroom-2160.webp"
               srcset="/ritual-printroom-1080.webp 1080w, /ritual-printroom-2160.webp 2160w"
               sizes="(max-width: 1128px) 100vw, 1080px"
               width="5120" height="2668" loading="lazy"
               alt="The Print Room in The Ritual on Mac — a print on Endura Premier above a seven-step test strip, with the paper, test strip, filter pack, dodge and burn, and preflash benches beneath it" />
        </figure>
      </section>

      <section class="ritual-block">
        <div class="ritual-words" data-reveal>
          <div class="label">Stories</div>
          <h2>Finish more than one photograph.</h2>
          <p class="fact">Rate, compare, collect and sequence on the Light Table. Then form covers, pairs, spreads, breaths and captions in a room made for reading the work.</p>
        </div>
        {/* The arranging, as a timelapse: the recording's dead tail cut and the thinking
            pauses compressed 7×, so the sequence forms in one breath. */}
        <figure class="ritual-plate wide" data-reveal>
          <video data-autoplay muted loop playsinline preload="none"
                 poster="/ritual-story-canvas-poster.webp" width="1920" height="1080"
                 aria-label="Spreads being arranged on the Story canvas in The Ritual — prints drawn onto a spine and paired into a sequence">
            <source src="/ritual-story-canvas.webm" type="video/webm" />
            <source src="/ritual-story-canvas.mp4" type="video/mp4" />
          </video>
        </figure>
        <p class="ritual-connector" data-reveal>Then it breathes.</p>
        <figure class="ritual-plate wide" data-reveal>
          {/* The one authorized stand-in from the old repo, until re-captured. */}
          <video data-autoplay muted loop playsinline preload="none"
                 poster="/story-mode-reader-poster.jpg" width="1920" height="1080"
                 aria-label="The Story reader — one spread breathing across the full screen">
            <source src="/story-mode-reader.webm" type="video/webm" />
            <source src="/story-mode-reader.mp4" type="video/mp4" />
          </video>
        </figure>
      </section>

      <section class="ritual-block tight">
        <div class="ritual-words" data-reveal>
          <div class="label">Archive &amp; Bridge</div>
          <h2>The work remains yours.</h2>
          <p class="fact">The Ritual keeps originals, source volumes and catalogue facts in their proper places. Bring a Lightroom Classic catalogue, or a Capture One catalogue or session, without changing the source.</p>
        </div>
        <p class="ritual-claim" data-reveal>Your curation arrives. Your photographs arrive as negatives.</p>
      </section>

      <section class="ritual-block">
        <div class="ritual-words right push" data-reveal>
          <div class="label">Two ways of sitting with it</div>
          <h2>The same Ritual, wherever you sit with the work.</h2>
          <p class="fact">Mac gives the work a room. iPad brings the same photographic process under your hands &mdash; not a lite edition; the same negative, print, retouch and story.</p>
          {/* The Mac ships first and the iPad follows. Saying so is not a
              hedge: the page must never read as though both can be had
              today, and the plan a reader buys already covers the second. */}
          <p class="fact ritual-soon"><strong>The Mac edition comes first.</strong> iPad follows, and every Mac plan already includes it &mdash; one Latent account, no second purchase.</p>
        </div>
        {/* One photograph, one develop state, two surfaces — the same frame at 4,906 K on
            Supra Endura, so the claim is shown rather than asserted. */}
        <div class="ritual-devices" data-reveal>
          <figure class="ritual-plate device-mac">
            <img src="/ritual-device-mac-1280.webp"
                 srcset="/ritual-device-mac-640.webp 640w, /ritual-device-mac-1280.webp 1280w"
                 sizes="(max-width: 900px) 90vw, 646px" width="5120" height="2598" loading="lazy"
                 alt="The Darkroom on Mac — a portrait of Youssef from Joun developing on Supra Endura, the emulsion list and scan finishes to one side" />
          </figure>
          <figure class="ritual-plate device-ipad">
            <img src="/ritual-device-ipad-900.webp"
                 srcset="/ritual-device-ipad-450.webp 450w, /ritual-device-ipad-900.webp 900w"
                 sizes="(max-width: 900px) 90vw, 430px" width="2746" height="1908" loading="lazy"
                 alt="The same portrait open in the Darkroom on iPad — the same emulsion, chemistry, paper and Retouch, under your hands" />
          </figure>
        </div>
      </section>

      <section class="ritual-close">
        <div class="ritual-words wide" data-reveal>
          <h2 class="large">From first import to the work you send out.</h2>
          <p class="fact">Send single photographs, batches, contact sheets and story proofs out in the shapes the work needs &mdash; with saved recipes, without leaving the room.</p>
        </div>
      </section>

      {ritualCommerce.releaseOpen && (
        <section id="access" class="ritual-access" data-reveal>
          <div class="ritual-access-head">
            <div>
              <div class="label">The independent Mac edition</div>
              <h2>Free, with the Latent mark.</h2>
            </div>
            <p class="fact">Install the complete workroom and use it &mdash; every tool, every stock, full-resolution exports, no card, nothing to cancel. Until you choose a plan, each photograph carries the Latent mark, on the canvas and in every export. A plan makes every photograph clean, on up to {ritualCommerce.supportedMacs} Macs, swapped whenever you like.</p>
          </div>
          <div class="ritual-plans">
            {ritualCommerce.plans.map((plan) => (
              <article class:list={['ritual-plan', { 'ritual-plan-featured': plan.id === 'annual' }]}>
                <div class="label small">{plan.name}</div>
                <p class="ritual-plan-price"><span>${plan.priceUsd}</span>{plan.cadence && <small> / {plan.cadence}</small>}</p>
                <p>{plan.note}</p>
              </article>
            ))}
          </div>
          <div class="ritual-access-action">
            <a class="ritual-door" href="/ritual/purchase">Get The Ritual for Mac<span class="home-berry ritual-door-berry" aria-hidden="true"></span></a>
            <p>Latent Manager holds your account, the secure checkout through Paddle, installation and updates. When a plan ends, The Ritual keeps working and the mark returns &mdash; your photographs and your original files are always yours.</p>
            <p>The Ritual for iPad arrives after the Mac and is included with every plan here, at no extra cost.</p>
          </div>
        </section>
      )}

      <section id="letters" class="ritual-letters" data-reveal>
        <div class="ritual-letters-row">
          <div class="home-letters-desk" data-newsletter>
            <div class="label">{truth.ritualStatus}</div>
            <p class="line">{ritualCommerce.releaseOpen ? 'Occasional letters from inside the workroom.' : 'The workroom is open to anyone who asks. Leave an address and we will send the build and the letter that comes with it.'}</p>
            <form class="home-letters-form" action={SUBSCRIBE_ENDPOINT} method="post" data-newsletter-form>
              <label class="visually-hidden" for="newsletter-email">Email address</label>
              <input id="newsletter-email" type="email" name="email" required autocomplete="email" placeholder="your address" />
              <input type="hidden" name="app" value="ritual" />
              <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true"
                     style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0;pointer-events:none" />
              <button type="submit" class="door">{ritualCommerce.releaseOpen ? 'Receive letters' : 'Join the beta'}</button>
            </form>
            <p class="home-letters-note" data-newsletter-error hidden role="alert">That email doesn't look right.</p>
            <p class="home-letters-note" data-newsletter-done hidden role="status" aria-live="polite">{ritualCommerce.releaseOpen ? 'You&rsquo;re on the list.' : 'You&rsquo;re on the list. The build comes next.'}</p>
          </div>
          <div class="home-letters-colophon">
            <nav aria-label="Site">
              <a href="/nera">Nera</a>
              <a href="/moment">The Moment</a>
              <a href="/lab">The Lab</a>
              <a href="/versos">Versos</a>
              <a href="/privacy">Privacy</a>
              <a href="/terms">Terms</a>
              <a href="mailto:contact@latentstudios.art">Contact</a>
            </nav>
            <p class="home-mark home-mark-foot">Latent Studios<span class="home-berry" aria-hidden="true"></span> &nbsp;&middot;&nbsp; &copy; 2026</p>
          </div>
        </div>
      </section>
    </main>
  </div>

  {/* newsletter.js is already loaded by Base.astro; only the reveal is this page's own. */}
  <script src="../scripts/reveal.js"></script>
</Base>
