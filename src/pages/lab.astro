---
// The Lab — Latent Print Engine, the moving-image print engine, in DaVinci Resolve.
//
// Same darkroom ground and repo tokens as /ritual, in the house's shell: the homepage's
// header and letters desk, Cormorant + Instrument Sans, left/right asymmetry, doors as
// words.
//
// Every fact here is the shipped plug-in's own (LatentOFX on print-engine/main, 2026-10-12):
// the catalog counts come from its film and paper lists, the curve from its spectral data,
// the frames from footage graded with it. The plug-in follows The Ritual's Film, Paper and
// Finish; a feature leaves this page the day it leaves the plug-in.
import Base from '../layouts/Base.astro';
import '../styles/home.css';
import '../styles/ritual.css';
import '../styles/lab.css';
import { truth } from '../config/truth';
import { labCommerce } from '../config/lab';
import sensitivity from '../data/vision3-250d-sensitivity.json';

const SUBSCRIBE_ENDPOINT = '/api/subscribe';

// Three moments from one graded film, each as it came off the camera and as the engine printed it.
const frames = [
  { name: 'The gate', before: '/lab/compare/gate-before.webp', after: '/lab/compare/gate-after.webp' },
  { name: 'The close-up', before: '/lab/compare/closeup-before.webp', after: '/lab/compare/closeup-after.webp' },
  { name: 'The stairs', before: '/lab/compare/stairs-before.webp', after: '/lab/compare/stairs-after.webp' },
];

// The catalog, as the plug-in's film and paper lists hold it.
const families = [
  { name: 'Colour negative', count: 41 },
  { name: 'Cinema', count: 7 },
  { name: 'Slide', count: 19 },
  { name: 'Kodachrome', count: 3 },
  { name: 'Black & white', count: 13 },
];
const layerColours = ['#d8604c', '#6fae72', '#5f86d6'];
---

<Base
  title="The Lab — Latent Print Engine for DaVinci Resolve"
  description="Real film, simulated from light to print, in one node inside your grade. 83 film stocks from their makers' own data, printed on 18 papers and print films. Latent Print Engine for DaVinci Resolve Studio."
  ogImage="/og-lab.png?v=1"
  ogImageAlt="The Lab — Latent Print Engine, in DaVinci Resolve"
  quiet={false}
  evening={false}
>
  <Fragment slot="head">
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/cormorant-500-normal-latin.woff2" />
  </Fragment>
  <div class="home ritual lab">

    <header class="home-header ritual-header">
      <a class="home-mark" href="/">Latent Studios<span class="home-berry" aria-hidden="true"></span></a>
      <nav class="home-nav" aria-label="Rooms">
        <a href="/nera">Nera</a>
        <a href="/moment">The Moment</a>
        <a href="/ritual">The Ritual</a>
        <a href="/lab" aria-current="page">The Lab</a>
        <a href="/versos">Versos</a>
        <a href="#letters">Letters</a>
      </nav>
    </header>

    <main id="main" class="ritual-main">

      <section class="ritual-hero">
        <div class="ritual-hero-row">
          <div class="ritual-hero-lead" data-reveal>
            <div class="label">Latent Print Engine &middot; an OpenFX node for DaVinci Resolve</div>
            <h1 class="ritual-title">The moving-image print engine.</h1>
            <p class="ritual-lede">Real film, simulated from light to print &mdash; in one node inside your grade.</p>
          </div>
          <div class="ritual-hero-aside" data-reveal>
            <p class="fact">This isn&rsquo;t a LUT. Each frame is exposed onto a film stock, developed, printed and viewed, the way the stock&rsquo;s own maker describes it &mdash; through the same engine as The Ritual.</p>
            <div class="label">{truth.labStatus}</div>
          </div>
        </div>
        <figure class="ritual-plate wide" data-reveal>
          <video data-autoplay muted loop playsinline preload="metadata"
                 poster="/lab-launch-poster.webp" width="1920" height="1080"
                 aria-label="Latent Print Engine: footage developed and printed through the engine, before and after">
            <source src="/lab-launch-1920.webm" type="video/webm" />
            <source src="/lab-launch-1920.mp4" type="video/mp4" />
          </video>
        </figure>
      </section>

      <section class="ritual-block tight">
        <div class="ritual-words" data-reveal>
          <div class="label">One node</div>
          <h2>The whole photochemical chain, frame after frame.</h2>
          <p class="fact">Your footage is the light that reached the camera. The engine carries it the way film did, and lets you work at every step.</p>
        </div>
        <div class="lab-chain" data-reveal>
          <span>Light</span><span class="lab-arrow" aria-hidden="true">&rarr;</span>
          <span>Negative</span><span class="lab-arrow" aria-hidden="true">&rarr;</span>
          <span>Development</span><span class="lab-arrow" aria-hidden="true">&rarr;</span>
          <span>Print</span><span class="lab-arrow" aria-hidden="true">&rarr;</span>
          <span>The frame</span>
        </div>
      </section>

      <section class="lab-pair">
        <div class="ritual-words" data-reveal>
          <div class="label">01 &middot; The negative</div>
          <h2>Every stock, from its maker&rsquo;s own data.</h2>
          <p class="fact">Eighty-three film stocks, each built from what its maker published: how each layer sees the spectrum, the dyes it forms, its characteristic curves, its grain. Nothing is matched to a look by eye and called a stock.</p>
          <p class="fact">The film sees the light your footage was shot in. Tell it the camera&rsquo;s white balance and a daylight stock under tungsten goes warm, a tungsten stock in daylight goes blue &mdash; as on set.</p>
          <div class="label">{families.map((f) => `${f.name} ${f.count}`).join(' · ')}</div>
        </div>
        <figure class="lab-card" data-reveal>
          <div class="lab-card-head"><span>Kodak Vision3 250D</span><span class="muted">Spectral sensitivity</span></div>
          <svg class="lab-curve" viewBox={`0 0 ${sensitivity.width} ${sensitivity.height}`} role="img"
               aria-label="Kodak Vision3 250D: the red, green and blue layers' spectral sensitivity, 380 to 780 nanometres">
            {sensitivity.paths.map((d, i) => <path d={d} fill="none" stroke={layerColours[i]} stroke-width="2" stroke-linejoin="round" />)}
          </svg>
          <div class="lab-axis">{[400, 500, 600, 700].map((nm) => <span style={`left: ${((nm - 380) / 400) * 100}%`}>{nm === 700 ? '700 nm' : nm}</span>)}</div>
          <figcaption>The three layers of Vision3 250D as Kodak publishes them, drawn from the data the engine develops it with.</figcaption>
        </figure>
      </section>

      <section class="lab-pair reverse">
        <figure class="lab-card wide" data-reveal>
          <div class="lab-card-head"><span>The print</span><span class="muted">18 papers &amp; print films</span></div>
          <div class="lab-row"><span class="label small">Colour paper</span><span>Endura &middot; Crystal Archive &middot; Edge</span></div>
          <div class="lab-row"><span class="label small">Print film</span><span>2383 &middot; 2393 &middot; CP30 &middot; ETERNA-CP</span></div>
          <div class="lab-row"><span class="label small">Silver</span><span>Multigrade RC &middot; FB &middot; Warmtone</span></div>
          <div class="lab-row"><span class="label small">Slides</span><span>Light box &middot; Projector &middot; Radiance</span></div>
          <div class="lab-row"><span class="label small">Lab scan</span><span>Frontier SP-3000 &middot; Noritsu HS-1800</span></div>
          <figcaption>Each negative is offered only what prints it: a colour negative its papers and scanners, a cinema negative its print films, a slide its viewers.</figcaption>
        </figure>
        <div class="ritual-words right" data-reveal>
          <div class="label">02 &middot; The print</div>
          <h2>Printed, the way a lab prints it.</h2>
          <p class="fact">Under the enlarger, with its colour head, flash and timing; through a cinema printer in printer lights, from the camera negative or a dupe of a dupe; scanned on a Frontier or a Noritsu; or a slide seen on a light box or thrown by a projector.</p>
          <p class="fact">Silver prints have their grades, split grade, and toning in selenium, sepia, iron blue, copper and gold.</p>
        </div>
      </section>

      <section class="ritual-block">
        <div class="ritual-words" data-reveal>
          <div class="label">03 &middot; The frame</div>
          <h2>Halation, grain and marks, new on every frame.</h2>
          <p class="fact">Halation glows from the light your camera actually clipped, found in the footage itself. The grain is particles on the film, sized on the frame you choose from Super&nbsp;16 to 8&times;10, and it renews every frame. Dust, hairs and scratches on the film change with it.</p>
        </div>
        <div class="lab-fixture" data-reveal>
          <figure class="ritual-plate lab-fixture-plate lab-compare" data-compare>
            <img data-compare-after src={frames[0].after} alt={`${frames[0].name}, developed and printed through Latent Print Engine`} width="1600" height="900" />
            <img data-compare-before class="lab-compare-before" src={frames[0].before} alt={`${frames[0].name}, as the camera recorded it`} width="1600" height="900" />
            <span class="lab-compare-line" aria-hidden="true"></span>
            <span class="lab-compare-tag left">The footage</span>
            <span class="lab-compare-tag right">Printed</span>
            <input class="lab-compare-range" type="range" min="0" max="100" value="50" aria-label="Compare the footage with the print" data-compare-range />
          </figure>
          <div class="lab-fixture-controls">
            <div class="lab-picker">
              <div class="label small">The frame</div>
              <div class="lab-frames">
                {frames.map((fr, fi) => (
                  <button type="button" class:list={['lab-frame', fi === 0 && 'is-active']} data-compare-frame={fi}>{fr.name}</button>
                ))}
              </div>
            </div>
            <p class="lab-note">Drag across the frame. Left is the footage as it came off the camera, through a plain Rec.709 conversion; right is the same frame through Latent Print Engine.</p>
          </div>
        </div>
      </section>

      <section class="ritual-aside-right">
        <div class="ritual-words right" data-reveal>
          <div class="label">Built for Resolve</div>
          <h2>Your colour pipeline, respected.</h2>
          <p class="fact">Bring the timeline in &mdash; DaVinci Wide Gamut, ACES or Rec.709 &mdash; or a camera&rsquo;s log straight in: eleven exact gamut-and-curve pairs. Deliver Rec.709, Rec.709-A, P3 or Rec.2020, or HDR in PQ and HLG, where a scanned negative or a projected slide may carry its light above paper white.</p>
          <p class="fact">The node renders the whole frame, so halation and grain never stop at a tile&rsquo;s edge. An HD frame develops in about 40&nbsp;ms on an M4&nbsp;Pro; for 4K, Resolve&rsquo;s render cache plays the print in real time.</p>
          <div class="label">Timeline &nbsp;&middot;&nbsp; Camera log &nbsp;&middot;&nbsp; SDR &amp; HDR delivery</div>
        </div>
      </section>

      <section class="lab-pair">
        <div class="ritual-words" data-reveal>
          <div class="label">The projector</div>
          <h2>The machine the film runs through.</h2>
          <p class="fact">A second node, Latent Projection, carries the print through a gate: gate mattes in 8, 16 and 35mm, weave that wanders more in 8mm than in 35mm, lamp flicker, the lens&rsquo;s slow breathing, and an amber edge code along the bottom for dailies.</p>
          <p class="fact">The Lab Report writes one line per frame &mdash; the recipe&rsquo;s fingerprint and the print&rsquo;s &mdash; so two machines can prove they made the same print.</p>
          <div class="label">Gate &nbsp;&middot;&nbsp; Weave &nbsp;&middot;&nbsp; Flicker &nbsp;&middot;&nbsp; Breathing &nbsp;&middot;&nbsp; Edge code</div>
        </div>
        <figure class="lab-card" data-reveal>
          <div class="lab-card-head"><span>Transport</span><span class="muted">35mm &middot; 24 fps</span></div>
          <div class="lab-specimen">
            <img src="/lab/compare/closeup-after.webp" alt="A frame printed through the engine, in the projector's gate" loading="lazy" />
          </div>
          <div class="lab-edgecode"><span>5207</span><span>push 0</span><span>gen 1</span><span>0147</span></div>
          <div class="lab-row"><span class="label small">Gate</span><span>35 &middot; 16 &middot; 8mm</span></div>
          <div class="lab-row"><span class="label small">Report</span><span>One line per frame</span></div>
          <figcaption>The edge code burns along the bottom of the frame, exposed amber like real key numbers.</figcaption>
        </figure>
      </section>

      <section class="ritual-close">
        <div class="ritual-words wide" data-reveal>
          <div class="label">One look, one engine</div>
          <h2 class="large">There is no second Latent.</h2>
          <p class="fact">The Lab runs the same spectral engine as The Ritual, with no simplified approximation of it anywhere. A negative developed in Resolve and one developed in The Ritual pass through the same emulsion, the same print, the same scanner.</p>
        </div>
      </section>

      <section id="buy" class="ritual-block tight">
        <div class="ritual-words wide" data-reveal>
          <div class="label">Latent Print Engine {labCommerce.version}</div>
          <h2 class="large">Film. Not a filter.</h2>
          <p class="fact">For DaVinci Resolve Studio on macOS. Start with {labCommerce.trialDays} days free, then keep it by the year or for good. One account, up to two Macs.</p>
          <div class="lab-plans">
            <div class="lab-row">
              <span class="lab-plan-name">Annual</span>
              <span class="label right">{labCommerce.trialDays}-day free trial</span>
              <span class="lab-plan-price">${labCommerce.yearlyUsd} / year</span>
            </div>
            <div class="lab-row">
              <span class="lab-plan-name">Lifetime</span>
              <span class="label right">One payment</span>
              <span class="lab-plan-price">${labCommerce.lifetimeUsd}</span>
            </div>
          </div>
          <div class="lab-doors">
            <a class="door" href={labCommerce.downloadHref}>Download for macOS</a>
            <a class="lab-secondary" href="/checkout">How purchase works</a>
          </div>
          <p class="lab-install">Install, open Latent Manager, sign in, start the trial or buy. Manager activates your Mac &mdash; there is no key to copy. Paddle is the merchant of record &middot; <a href="/refund">30-day refunds</a> &middot; <a href="/terms">Terms</a></p>
        </div>
      </section>

      <section id="letters" class="ritual-letters" data-reveal>
        <div class="ritual-letters-row">
          <div class="home-letters-desk" data-newsletter>
            <div class="label">Letters from the studio</div>
            <p class="line">Occasional notes on Print Engine releases, new materials, and the work happening inside Latent.</p>
            <form class="home-letters-form" action={SUBSCRIBE_ENDPOINT} method="post" data-newsletter-form>
              <label class="visually-hidden" for="newsletter-email">Email address</label>
              <input id="newsletter-email" type="email" name="email" required autocomplete="email" placeholder="your address" />
              <input type="hidden" name="app" value="lab" />
              <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true"
                     style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0;pointer-events:none" />
              <button type="submit" class="door">Join the letters</button>
            </form>
            <p class="home-letters-note" data-newsletter-error hidden role="alert">That email doesn't look right.</p>
            <p class="home-letters-note" data-newsletter-done hidden role="status" aria-live="polite">You&rsquo;re on the list. Letters will be rare.</p>
          </div>
          <div class="home-letters-colophon">
            <nav aria-label="Site">
              <a href="/nera">Nera</a>
              <a href="/moment">The Moment</a>
              <a href="/ritual">The Ritual</a>
              <a href="/versos">Versos</a>
              <a href="/privacy">Privacy</a>
              <a href="/terms">Terms</a>
              <a href="/refund">Refunds</a>
              <a href="mailto:support@latentstudios.art">Support</a>
            </nav>
            <p class="home-mark home-mark-foot">Latent Studios<span class="home-berry" aria-hidden="true"></span> &nbsp;&middot;&nbsp; &copy; 2026</p>
          </div>
        </div>
      </section>
    </main>
  </div>

  <script define:vars={{ frames }}>
    // The compare: pick a frame, drag across it. Both images of every frame are decoded up front so
    // stepping between frames never shows a gap.
    (() => {
      const plate = document.querySelector('[data-compare]');
      if (!plate) return;
      const after = plate.querySelector('[data-compare-after]');
      const before = plate.querySelector('[data-compare-before]');
      const range = plate.querySelector('[data-compare-range]');
      for (const f of frames) for (const src of [f.before, f.after]) { const im = new Image(); im.src = src; }
      const setSplit = (v) => plate.style.setProperty('--split', `${v}%`);
      range.addEventListener('input', () => setSplit(range.value));
      setSplit(range.value);
      document.querySelectorAll('[data-compare-frame]').forEach((b) =>
        b.addEventListener('click', () => {
          const F = frames[Number(b.dataset.compareFrame)];
          after.src = F.after; after.alt = `${F.name}, developed and printed through Latent Print Engine`;
          before.src = F.before; before.alt = `${F.name}, as the camera recorded it`;
          document.querySelectorAll('[data-compare-frame]').forEach((o) => o.classList.toggle('is-active', o === b));
        }));
    })();
  </script>
  {/* newsletter.js is already loaded by Base.astro; only the reveal is this page's own. */}
  <script src="../scripts/reveal.js"></script>
</Base>
