---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  /** Which light the page lives in: the studio's paper, or an instrument's darkroom. */
  room?: 'paper' | 'dark';
  /** Browser chrome colour; defaults to the room's ground. The homepage's silk is darker than the studio's paper. */
  themeColor?: string;
  /** Load quiet.js (reveals, safelight, autoplay discipline). The homepage carries its own motion and opts out. */
  quiet?: boolean;
}

const {
  title = 'Latent Studios',
  description = 'Born before the act. Latent Studios is an art house making instruments that help artists understand and realize themselves — Nera, The Moment, The Ritual, The Lab, and Versos.',
  ogImage = '/og.png?v=5',
  ogImageAlt = 'Latent Studios',
  room = 'dark',
  themeColor = room === 'paper' ? '#f3efe6' : '#1A1614',
  quiet = true,
} = Astro.props;

const ogImageURL = `https://latentritual.com${ogImage}`;
const canonicalURL = new URL(Astro.url.pathname, 'https://latentritual.com').href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Latent Studios',
  description,
  url: 'https://latentritual.com',
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <title>{title}</title>

    <link rel="icon" type="image/svg+xml" href="/icon.svg?v=5" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icon-32.png?v=5" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icon-180.png?v=5" />

    <!-- Fonts are self-hosted (styles/fonts.css) — no third-party requests.
         The darkroom's display face is preloaded; paper pages preload their own via the head slot. -->
    {room !== 'paper' && <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/outfit-latin.woff2" />}
    <slot name="head" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- The lamplit evening, decided before first paint: the visitor's stored
         choice wins; otherwise the room warms after local sunset. quiet.js
         wires the footer lamp that overrides this. -->
    <script is:inline>
      (() => {
        try {
          var stored = localStorage.getItem('latent-lamp');
          var hour = new Date().getHours();
          var evening = stored ? stored === 'on' : (hour >= 19 || hour < 6);
          if (evening) document.documentElement.classList.add('is-evening');
        } catch (e) {}
      })();
    </script>
  </head>

  <body class={room === 'paper' ? 'room-paper' : ''} data-no-quiet={quiet ? undefined : ''}>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <script>
      import '../scripts/quiet.js';
      import '../scripts/newsletter.js';
    </script>
  </body>
</html>
