---
// The announcement bar (config/announce.js). The head script in Base.astro marks <html data-announce> before
// first paint unless this visitor closed this announcement, so pinned headers move down without a jump.
import { announce } from '../config/announce.js';
---
<div class="announce" role="region" aria-label="Announcement" data-announce-bar>
  <a class="announce-link" href={announce.href}>
    <span class="announce-lead announce-long">{announce.lead}</span>
    <span class="announce-lead announce-short">{announce.short}</span>
    <span class="announce-tail">{announce.tail}</span>
    <span class="announce-door">{announce.door} &rarr;</span>
  </a>
  <button type="button" class="announce-close" aria-label="Close the announcement" data-announce-close>&times;</button>
</div>
<script is:inline define:vars={{ key: `latent-announce-closed:${announce.id}` }}>
  (() => {
    const bar = document.querySelector('[data-announce-bar]');
    bar && bar.querySelector('[data-announce-close]').addEventListener('click', () => {
      try { localStorage.setItem(key, '1'); } catch (e) { /* private mode: closed for this page only */ }
      document.documentElement.removeAttribute('data-announce');
      bar.remove();
    });
  })();
</script>
<style is:global>
  :root { --announce-h: 40px; }
  @media (max-width: 720px) { :root { --announce-h: 56px; } }
  .announce { display: none; }
  html[data-announce] .announce {
    position: fixed; inset: 0 0 auto 0; z-index: 200; height: var(--announce-h);
    display: flex; align-items: center; justify-content: center; gap: 8px; padding: 0 44px 0 16px;
    background: #1A1614; color: #E8DDD0; border-bottom: 1px solid rgba(212, 196, 176, 0.14);
  }
  html[data-announce] body { padding-top: var(--announce-h); }
  html[data-announce] .home-header, html[data-announce] nav[data-nav] { top: var(--announce-h); }
  .announce-link {
    display: flex; flex-wrap: wrap; align-items: baseline; justify-content: center; gap: 2px 10px;
    color: inherit; text-decoration: none; text-align: center;
    font-family: 'Instrument Sans', -apple-system, 'Helvetica Neue', Arial, sans-serif; font-weight: 500; font-size: 12.5px; line-height: 1.35; letter-spacing: 0.02em;
  }
  .announce-lead { color: #E8DDD0; }
  .announce-tail { color: #a99a8a; }
  .announce-door { color: #E8C4A0; letter-spacing: 0.14em; text-transform: uppercase; font-size: 11px; white-space: nowrap; }
  .announce-link:hover .announce-door, .announce-link:focus-visible .announce-door { color: #E8DDD0; }
  .announce-link:focus-visible { outline: 1px solid #E8C4A0; outline-offset: 4px; }
  .announce-short { display: none; }
  .announce-close {
    position: absolute; right: 8px; top: 50%; transform: translateY(-50%);
    width: 32px; height: 32px; border: 0; background: none; color: #a99a8a; font-size: 20px; line-height: 1; cursor: pointer; border-radius: 50%;
  }
  .announce-close:hover, .announce-close:focus-visible { color: #E8DDD0; background: rgba(232, 221, 208, 0.08); outline: none; }
  @media (max-width: 720px) {
    .announce-long, .announce-tail { display: none; }
    .announce-short { display: inline; }
    /* on a phone the house header is in the flow (not pinned): the body's padding already moves it */
    html[data-announce] .home-header { top: 0; }
  }
</style>
