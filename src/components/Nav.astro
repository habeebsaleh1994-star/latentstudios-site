---
// Nav — the site's header (2026-10-30): the Latent Studios mark and the rooms, as the home page and every instrument
// page draw it (home.css). A page that uses it wraps its content in `<div class="home">`, with Footer at the end.
import '../styles/home.css';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const rooms = [
  { label: 'The Ritual', href: '/ritual' },
  { label: 'The Moment', href: '/moment' },
  { label: 'The Lab', href: '/lab' },
  { label: 'The Wall', href: 'https://wall.latentstudios.art' },
];
---

<header class="home-header">
  <a class="home-mark" href="/">Latent Studios<span class="home-berry" aria-hidden="true"></span></a>
  <nav class="home-nav" aria-label="Rooms">
    {rooms.map((r) => <a href={r.href} aria-current={path === r.href ? 'page' : undefined}>{r.label}</a>)}
    <a href="#letters">Letters</a>
  </nav>
</header>
