{
  "name": "latent-studio-local",
  "private": true,
  "version": "0.18.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5181 --strictPort",
    "build": "tsc -b && npm run typecheck:backend && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5181 --strictPort",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write src backend tests scripts *.ts *.js *.json index.html",
    "typecheck:backend": "tsc -p tsconfig.backend.json",
    "backend:demo": "node scripts/backend-demo.mjs",
    "studio:lib": "node scripts/build-studio-lib.mjs",
    "wall:sync": "node scripts/sync-to-site.mjs",
    "matrix": "node scripts/matrix.mjs",
    "matrix:quick": "node scripts/matrix.mjs --quick"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "25.9.9",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "0.28.2",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.2.4",
    "globals": "^16.4.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.0",
    "vitest": "4.1.11"
  }
}
