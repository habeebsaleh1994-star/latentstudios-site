    {
      "id": "the-door",
      "title": "The door",
      "titleEm": "remembers",
      "inNav": true,
      "kind": "writing",
      "form": "Poem",
      "place": "Beirut",
      "year": "2026",
      "paras": [
        "The door remembers\nthe shape of every leaving:\na hand, a weight, the small\nhesitation before the latch.\n\nIt keeps no names.\nIt keeps the draught\nthat followed you out,\nand the light that did not."
      ],
